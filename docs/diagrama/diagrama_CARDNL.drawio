        <mxCell id="c2" parent="1" style="text;html=1;fontSize=18;fontColor=#546E7A;align=left;verticalAlign=middle;whiteSpace=wrap;" value="Una red local para alertas y recursos que funciona sin internet ni señal de celular" vertex="1">
          <mxGeometry height="30" width="1000" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="casa" parent="1" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;strokeWidth=3;shadow=1;fontSize=15;fontColor=#37474F;align=left;verticalAlign=top;spacing=10;overflow=fill;" value="&lt;div style=&quot;background:#E3F2FD;margin:-10px -10px 6px -10px;padding:10px 18px;border-bottom:1.5px solid #1E88E5;border-radius:16px 16px 0 0&quot;&gt;&lt;b style=&quot;font-size:20px;color:#1E88E5&quot;&gt;Nodo en la casa&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px;color:#37474F&quot;&gt;ESP32 (simulado en Cirkit)&lt;/b&gt;&lt;/div&gt;&lt;ul style=&quot;margin:8px 0 0 0;padding-left:20px&quot;&gt;&lt;li style=&quot;margin-bottom:5px&quot;&gt;3 botones: agua, comida y medicina&lt;/li&gt;&lt;li style=&quot;margin-bottom:5px&quot;&gt;Pantalla OLED (ej.: «REQUEST SENT / Need Water»)&lt;/li&gt;&lt;li style=&quot;margin-bottom:5px&quot;&gt;Sensor de nivel de agua (detecta inundación)&lt;/li&gt;&lt;li style=&quot;margin-bottom:5px&quot;&gt;LED que confirma el pedido&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="300" width="280" x="40" y="220" as="geometry" />
        </mxCell>
        <mxCell id="rec" parent="1" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E24AA;strokeWidth=3;shadow=1;fontSize=15;fontColor=#37474F;align=left;verticalAlign=top;spacing=10;overflow=fill;" value="&lt;div style=&quot;background:#F3E5F5;margin:-10px -10px 6px -10px;padding:10px 18px;border-bottom:1.5px solid #8E24AA;border-radius:16px 16px 0 0&quot;&gt;&lt;b style=&quot;font-size:20px;color:#8E24AA&quot;&gt;Receptor&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px;color:#37474F&quot;&gt;Placa Heltec LoRa 32 V3&lt;/b&gt;&lt;/div&gt;&lt;ul style=&quot;margin:8px 0 0 0;padding-left:20px&quot;&gt;&lt;li style=&quot;margin-bottom:5px&quot;&gt;Recibe por radio los mensajes de todas las casas&lt;/li&gt;&lt;li style=&quot;margin-bottom:5px&quot;&gt;Se los pasa a la Raspberry Pi por cable USB&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="265" width="230" x="420" y="255" as="geometry" />
        </mxCell>
        <mxCell id="pi" parent="1" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;strokeWidth=3;shadow=1;fontSize=15;fontColor=#37474F;align=left;verticalAlign=top;spacing=10;overflow=fill;" value="&lt;div style=&quot;background:#E8F5E9;margin:-10px -10px 6px -10px;padding:10px 18px;border-bottom:1.5px solid #43A047;border-radius:16px 16px 0 0&quot;&gt;&lt;b style=&quot;font-size:20px;color:#43A047&quot;&gt;Centro comunitario&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px;color:#37474F&quot;&gt;Raspberry Pi 4&lt;/b&gt;&lt;/div&gt;&lt;ul style=&quot;margin:8px 0 0 0;padding-left:20px&quot;&gt;&lt;li style=&quot;margin-bottom:5px&quot;&gt;Gateway en Python: recibe y guarda cada mensaje (en desarrollo)&lt;/li&gt;&lt;li style=&quot;margin-bottom:5px&quot;&gt;Base de datos SQLite con 4 tablas: requests, resources, alerts, deliveries&lt;/li&gt;&lt;li style=&quot;margin-bottom:5px&quot;&gt;Inventario del Community Center (ej.: Water: 5)&lt;/li&gt;&lt;li style=&quot;margin-bottom:5px&quot;&gt;Tablero web en Flask&lt;/li&gt;&lt;li style=&quot;margin-bottom:5px&quot;&gt;Crea su propio Wi-Fi local&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="390" width="300" x="750" y="150" as="geometry" />
        </mxCell>
        <mxCell id="tab" parent="1" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FB8C00;strokeWidth=3;shadow=1;fontSize=15;fontColor=#37474F;align=left;verticalAlign=top;spacing=10;overflow=fill;" value="&lt;div style=&quot;background:#FFF3E0;margin:-10px -10px 6px -10px;padding:10px 18px;border-bottom:1.5px solid #FB8C00;border-radius:16px 16px 0 0&quot;&gt;&lt;b style=&quot;font-size:20px;color:#FB8C00&quot;&gt;Tablero web&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px;color:#37474F&quot;&gt;Celular o laptop&lt;/b&gt;&lt;/div&gt;&lt;ul style=&quot;margin:8px 0 0 0;padding-left:20px&quot;&gt;&lt;li style=&quot;margin-bottom:5px&quot;&gt;Emergency Alerts (ej.: House A, Flood Detected)&lt;/li&gt;&lt;li style=&quot;margin-bottom:5px&quot;&gt;Active Requests (ej.: House A needs Water)&lt;/li&gt;&lt;li style=&quot;margin-bottom:5px&quot;&gt;Available Resources (ej.: Community Center)&lt;/li&gt;&lt;li style=&quot;margin-bottom:5px&quot;&gt;Deliveries (ej.: Medicine, House A → House H)&lt;/li&gt;&lt;li style=&quot;margin-bottom:5px&quot;&gt;Para vecinos, líderes y organizaciones&lt;/li&gt;&lt;/ul&gt;" vertex="1">
